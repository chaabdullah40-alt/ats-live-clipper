# ATS Live Clipper - copy this file to .env and fill in your own keys.
# NEVER commit a real .env file. NEVER paste a real key into code or chat history.
# Get a free YouTube Data API v3 key from Google Cloud Console:
#   console.cloud.google.com -> New Project -> APIs & Services -> Library
#   -> YouTube Data API v3 -> Enable -> Credentials -> Create Credentials -> API Key
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_V3_KEY_HERE

# Optional, for Gemini AI scene analysis. Get a free key from Google AI Studio:
#   aistudio.google.com -> Get API key -> Create API key
# If this is empty or quota is exceeded (HTTP 429), the app falls back
# silently to chat + motion detection. No error is shown to the user.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# Optional: only if you want the Innertube comments fallback.
# Leave empty to skip it. Never hard-code a key in code.
INNERTUBE_API_KEY=

# Local server port (Vercel ignores this)
PORT=3000
